# Facultatif : si absent, le serveur utilise automatiquement un modèle
# Ollama local et gratuit (voir OLLAMA_MODEL / OLLAMA_HOST ci-dessous).
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

PORT=3001

# Utilisés seulement si ANTHROPIC_API_KEY n'est pas défini.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Paiement du forfait Pro (99€, paiement unique) — sans ces deux clés, le
# bouton PayPal reste désactivé et un message d'erreur s'affiche au client.
# Sandbox pour tester (https://developer.paypal.com/dashboard/), "live" pour
# les vrais paiements une fois prêt.
PAYPAL_CLIENT_ID=votre-client-id-paypal
PAYPAL_CLIENT_SECRET=votre-client-secret-paypal
PAYPAL_ENV=sandbox
PAYPAL_PRICE_PRO=99.00
